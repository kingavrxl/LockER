<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/night_blue"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="24dp">

        <!-- En-tête Badge Sécurité MDM (Bleu nuit & Vert) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@color/night_blue_card"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:layout_marginTop="12dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:tint="@color/green_emerald"
                android:src="@android:drawable/ic_lock_lock"
                android:contentDescription="Security Badge" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" LOCKER MDM ENTERPRISE "
                android:textColor="@color/green_emerald"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />
        </LinearLayout>

        <!-- Icône de Cadenas Moderne (Vert Émeraude) -->
        <ImageView
            android:id="@+id/ivLockIcon"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginTop="20dp"
            android:tint="@color/green_emerald"
            android:src="@android:drawable/ic_lock_lock"
            android:contentDescription="Lock Icon" />

        <!-- Titre Principal (Blanc Épuré) -->
        <TextView
            android:id="@+id/tvLockTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="ACCÈS TEMPORAIREMENT SUSPENDU"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textAlignment="center" />

        <!-- Sous-titre Sober (Blanc adouci) -->
        <TextView
            android:id="@+id/tvLockSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="En attente de régularisation de versement"
            android:textColor="@color/white_muted"
            android:textSize="13sp"
            android:textAlignment="center" />

        <!-- Carte Centrale d'Information (Bleu Nuit & Bordure) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/night_blue_card"
            android:padding="16dp"
            android:layout_marginTop="18dp">

            <!-- Tag de statut -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MOTIF OFFICIEL"
                android:textColor="@color/green_emerald"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <!-- Motif dynamique -->
            <TextView
                android:id="@+id/tvLockReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="Échéance de versement dépassée" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/night_blue_border"
                android:layout_marginVertical="10dp" />

            <!-- Message explicatif respectueux et sobre -->
            <TextView
                android:id="@+id/tvLockInstructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pour réactiver l'accès complet et immédiat à votre smartphone, veuillez effectuer votre versement via Mobile Money. Votre terminal se déverrouille automatiquement dès réception."
                android:textColor="@color/white_muted"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <!-- Bouton 1 : Payer par Mobile Money (Vert Émeraude vif, texte Noir) -->
        <Button
            android:id="@+id/btnPayNow"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/green_emerald"
            android:textColor="@color/black"
            android:text="💳 RÉGULARISER PAR MOBILE MONEY"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Bouton 2 : Actualiser après paiement (Bleu Nuit avec texte Vert) -->
        <Button
            android:id="@+id/btnRefreshStatus"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/night_blue_card"
            android:textColor="@color/green_emerald"
            android:text="🔄 VÉRIFIER LE PAIEMENT (DÉBLOQUER)"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Bouton 3 : Appeler le Support Flotte (Bleu Nuit, texte Blanc) -->
        <Button
            android:id="@+id/btnCallSupport"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/night_blue_card"
            android:textColor="@color/white"
            android:text="📞 CONTACTER LE GESTIONNAIRE"
            android:textSize="12sp" />

        <!-- Bouton 4 : Appel d'Urgence 112 (Sobre, conforme, fond Noir/Bleu nuit, texte Blanc) -->
        <Button
            android:id="@+id/btnEmergencyCall"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/black"
            android:textColor="@color/white"
            android:text="🚨 APPEL D'URGENCE (112)"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Mention Légale et Identifiant -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="LockER Protection Flotte • Conforme Standards MDM"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:textAlignment="center" />

    </LinearLayout>
</ScrollView>
