<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <!-- Icône de Cadenas -->
    <ImageView
        android:id="@+id/ivLockIcon"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:tint="#EF4444"
        android:src="@android:drawable/ic_lock_power_off" />

    <!-- Titre Principal -->
    <TextView
        android:id="@+id/tvLockTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="TÉLÉPHONE BLOQUÉ"
        android:textColor="#EF4444"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textAlignment="center" />

    <!-- Sous-titre explicatif -->
    <TextView
        android:id="@+id/tvLockSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Retard de paiement journalier ≥ 3 jours"
        android:textColor="#E2E8F0"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textAlignment="center" />

    <!-- Message d'instructions -->
    <TextView
        android:id="@+id/tvLockInstructions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="L'utilisation de ce véhicule/téléphone est temporairement suspendue. Veuillez régulariser votre versement journalier via MTN Mobile Money ou Moov Money pour rétablir instantanément l'appareil."
        android:textColor="#94A3B8"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:textAlignment="center" />

    <!-- Motif spécifique -->
    <TextView
        android:id="@+id/tvLockReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#1E293B"
        android:padding="12dp"
        android:textColor="#F59E0B"
        android:textSize="13sp"
        android:text="Motif : Impayé détecté par le système central"
        android:textAlignment="center" />

    <!-- Espacement -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bouton Payer Immédiatement (Mobile Money Bénin) -->
    <Button
        android:id="@+id/btnPayNow"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="#059669"
        android:textColor="#FFFFFF"
        android:text="💳 PAYER MON FORFAIT (5 000 FCFA)"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Bouton Appeler le Support de Flotte -->
    <Button
        android:id="@+id/btnCallSupport"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="#2563EB"
        android:textColor="#FFFFFF"
        android:text="📞 APPELER LE SUPPORT FLOTTE"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Bouton Actualiser l'état (après paiement) -->
    <Button
        android:id="@+id/btnRefreshStatus"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="#334155"
        android:textColor="#FFFFFF"
        android:text="🔄 J'AI PAYÉ (ACTUALISER LE STATUT)"
        android:textSize="13sp" />

    <!-- Bouton Urgences (Obligation Légale Bénin / Secours 112) -->
    <Button
        android:id="@+id/btnEmergencyCall"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="#DC2626"
        android:textColor="#FFFFFF"
        android:text="APPEL D'URGENCE (112)"
        android:textSize="14sp" />

</LinearLayout>
