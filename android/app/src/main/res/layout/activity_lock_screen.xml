<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070D1E"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- En-tête Badge Sécurité MDM -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#162035"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:layout_marginTop="20dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:tint="#10B981"
                android:src="@android:drawable/ic_lock_lock" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" LOCKER MDM ENTERPRISE "
                android:textColor="#10B981"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.15" />
        </LinearLayout>

        <!-- Icône de Cadenas Stylisée -->
        <ImageView
            android:id="@+id/ivLockIcon"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginTop="24dp"
            android:tint="#EF4444"
            android:src="@android:drawable/ic_lock_power_off" />

        <!-- Titre Principal -->
        <TextView
            android:id="@+id/tvLockTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="TERMINAL TEMPORAIREMENT BLOQUÉ"
            android:textColor="#F8FAFC"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textAlignment="center" />

        <!-- Sous-titre -->
        <TextView
            android:id="@+id/tvLockSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Échéance de versement journalier en attente"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:textAlignment="center" />

        <!-- Boîte de Détail / Motif -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0F1B33"
            android:padding="16dp"
            android:layout_marginTop="20dp">

            <TextView
                android:id="@+id/tvLockReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#F59E0B"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="Motif : Impayé détecté par le système central (≥ 3 jours)"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/tvLockInstructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Régularisez votre compte via Mobile Money pour débloquer automatiquement ce téléphone en moins de 30 secondes."
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp"
                android:textAlignment="center" />
        </LinearLayout>

        <!-- Bouton Principal Payer Immédiatement (Vert Émeraude) -->
        <Button
            android:id="@+id/btnPayNow"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#059669"
            android:textColor="#FFFFFF"
            android:text="💳 PAYER VIA MOBILE MONEY (5 000 FCFA)"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Bouton Actualiser l'état (après paiement) -->
        <Button
            android:id="@+id/btnRefreshStatus"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#10B981"
            android:textColor="#0B132B"
            android:text="🔄 J'AI EFFECTUÉ LE PAIEMENT (DÉBLOQUER)"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Bouton Appeler le Support Flotte -->
        <Button
            android:id="@+id/btnCallSupport"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#1E293B"
            android:textColor="#F1F5F9"
            android:text="📞 APPELER LE GESTIONNAIRE DE FLOTTE"
            android:textSize="13sp" />

        <!-- Bouton Appel d'Urgence (112 SAMU / Police) -->
        <Button
            android:id="@+id/btnEmergencyCall"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#DC2626"
            android:textColor="#FFFFFF"
            android:text="🚨 APPEL D'URGENCE (112)"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Mention Légale et Identifiant -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="LockER Bénin • Protection Conforme Code du Numérique"
            android:textColor="#64748B"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
